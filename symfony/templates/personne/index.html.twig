{% extends 'base.html.twig' %}

{% block title %}Hello PersonneController!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>Hello {{ controller_name }}! ✅</h1>

    This friendly message is coming from:
    <ul>
        <li>Your controller at <code>/home/philippe/my_project_directory/src/Controller/PersonneController.php</code></li>
        <li>Your template at <code>/home/philippe/my_project_directory/templates/personne/index.html.twig</code></li>
    </ul>

<table>
{% for personne in personnes %}
<tr>
<td>{{personne.id}}</td>
<td>{{personne.prenom}}</td>
<td>{{personne.nom}}</td>
<td>{{personne.foyer.id}}</td>
<td>{{personne.foyer.nom}}</td>
<td>{{personne.foyer.responsable}}</td>
</tr>
{% endfor %}
</table>
<table>
{% for sacrement in sacrements %}
<tr>
<td>{{ sacrement.id }}</td>
<td>{{ sacrement.type }}</td>
</tr>
{% endfor %}
</table>

</div>
{% endblock %}
